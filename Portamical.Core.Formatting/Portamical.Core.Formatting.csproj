<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build Settings -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SonarQubeTestProject>False</SonarQubeTestProject>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Package Info -->
    <Version>2.1.1</Version>
    <Title>Portamical.Core.Formatting</Title>
    <Authors>CsabaDu</Authors>
    <Company>CsabaDu</Company>
    <Description>Extensible formatting infrastructure for Portamical test data framework. Provides type-specific formatters, custom formatter registry, and zero-allocation string building for human-readable test case names and diagnostic output.</Description>
    <Copyright>(c) 2026. Csaba Dudas (CsabaDu)</Copyright>

    <!-- Package Assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

    <!-- Repository -->
    <RepositoryUrl>https://github.com/CsabaDu/Portamical/tree/master/Portamical.Core.Formatting</RepositoryUrl>
    <PackageTags>formatting; testdata; extensible; performant; zeroallocation; logging; customformat; portamical;</PackageTags>

    <!-- Release Notes -->
    <PackageReleaseNotes>
      v2.1.1 (2026-06-30) - Documentation and Quality Improvements

      Documentation Enhancements:
      • Completed XML documentation for all private members and methods
      • Added detailed performance optimization documentation (14 distinct optimizations)
      • Enhanced inline documentation with usage examples and design rationale
      • Improved cross-references using proper &lt;see cref/&gt; tags

      String Building Optimizations:
      • StringBuilder capacity pre-computation for ICollection&lt;T&gt; (no size threshold)
      • Fast-path iterative joining for small lists (1-3 items) vs StringBuilder for larger collections
      • Zero-allocation string building using string.Create and span operations
      • Tuple formatting optimized for up to 8 elements (primary tuple structure)
      • Local method pattern for reduced allocations in tight loops

      Code Quality:
      • Enhanced null handling with explicit fallback strategies
      • Improved error handling in Stream formatting with DEBUG diagnostics
      • Thread-safe concurrent caching for hot-path operations
      • Comprehensive XML documentation for all public and private APIs

      For details: https://github.com/CsabaDu/Portamical/blob/master/Portamical.Core.Formatting/README.md
    </PackageReleaseNotes>

    <!-- Package Generation -->
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>

    <!-- Symbols -->
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Documentation -->
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
