<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build Settings -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SonarQubeTestProject>False</SonarQubeTestProject>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Package Info -->
    <Version>3.0.0</Version>
    <Title>Portamical.Core.Formatting</Title>
    <Authors>CsabaDu</Authors>
    <Company>CsabaDu</Company>
    <Description>Extensible formatting infrastructure for Portamical test data framework. Provides type-specific formatters, custom formatter registry, and zero-allocation string building for human-readable test case names and diagnostic output.</Description>
    <Copyright>(c) 2026. Csaba Dudas (CsabaDu)</Copyright>

    <!-- Package Assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

    <!-- Repository -->
    <RepositoryUrl>https://github.com/CsabaDu/Portamical/tree/master/Portamical.Core.Formatting</RepositoryUrl>
    <PackageTags>formatting; testdata; extensible; performant; zeroallocation; logging; customformat; portamical;</PackageTags>

    <!-- Release Notes -->
    <PackageReleaseNotes>
      v2.2.0 (2026-08-07) - Safety and Quality Improvements

      Builder Enhancements:
      • Added truncation safety in CopyAsSpan for insufficient buffer space
      • Enhanced DEBUG diagnostics with Debug.WriteLine (no production overhead)
      • Prevents buffer overflow exceptions with automatic span slicing

      Code Quality:
      • Reorganized DefaultFormatter with #region directives for better navigation
      • Enhanced exception formatting consistency in Stream error handling
      • Fixed FileVersion typo in Portamical.NUnit.csproj

      Testing:
      • Added 4 new CopyAsSpan safety tests for edge cases (358 total tests)
      • Expanded coverage for truncation and boundary scenarios

      Compatibility:
      • No breaking changes - drop-in replacement for v2.1.1
      • Zero-allocation performance characteristics preserved

      For details: https://github.com/CsabaDu/Portamical/blob/master/Portamical.Core.Formatting/README.md
    </PackageReleaseNotes>
    
    <!-- Package Generation -->
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>

    <!-- Symbols -->
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Documentation -->
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests.Portamical.Core.Formatting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
