<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build Settings -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SonarQubeTestProject>False</SonarQubeTestProject>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Package Info -->
    <Version>3.0.0</Version>
    <Title>Portamical.Core.Formatting</Title>
    <Authors>CsabaDu</Authors>
    <Company>CsabaDu</Company>
    <Description>Extensible formatting infrastructure for Portamical test data framework. Provides type-specific formatters, custom formatter registry, and zero-allocation string building for human-readable test case names and diagnostic output.</Description>
    <Copyright>(c) 2026. Csaba Dudas (CsabaDu)</Copyright>

    <!-- Package Assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

    <!-- Repository -->
    <RepositoryUrl>https://github.com/CsabaDu/Portamical/tree/master/Portamical.Core.Formatting</RepositoryUrl>
    <PackageTags>formatting; testdata; extensible; performant; zeroallocation; logging; customformat; portamical;</PackageTags>

    <!-- Release Notes -->
    <PackageReleaseNotes>
      v3.0.0 (2026-09-21) - API Surface and Null-Safety Refinements

      Breaking Change:
      • DefaultFormatter is now internal; use Formatter.Format(...) or Formatter.GetFormatter(...) instead

      Formatter API:
      • GetFormatter now accepts Type? and returns the default formatter for null input
      • Unregistered non-null types continue to use the default formatter
      • XML documentation now describes the null-safe fallback contract

      Internal Maintenance:
      • Renamed Builder's private separator constant for clarity
      • Clarified enumerable and formatter-region naming
      • Added scoped warning suppression for DEBUG-only stream diagnostics
      • Removed redundant explicit imports supplied by implicit/global usings
      • Refined XML documentation references and implementation descriptions

      Compatibility:
      • Formatter.Format, formatter registration, Formatter&lt;T&gt;, and public Builder APIs are unchanged
      • Direct DefaultFormatter usage must migrate to the public Formatter facade

      For details: https://github.com/CsabaDu/Portamical/blob/master/Portamical.Core.Formatting/README.md
    </PackageReleaseNotes>
    
    <!-- Package Generation -->
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>

    <!-- Symbols -->
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Documentation -->
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests.Portamical.Core.Formatting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
