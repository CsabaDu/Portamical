#title: Portamical_Packages_Dependencies_Details
#direction: right

#.contract: fill=#DCE8CF title=center,italic,bold body=left,italic
#.static: fill=#C9DEEF title=center,bold,underline body=left,italic
#.package: title=bold,left visual=frame
#.concrete: fill=#C9DEEF title=center,bold body=left
#.abstract: fill=#C9DEEF title=center,bold, italic body=left

#.core: fill=#ffe6e6 title=bold,left visual=frame
#.shared: fill=#ffcccc title=bold,left visual=frame
#.native: fill=#ffb3b3 title=bold,left visual=frame
#.framework: fill=#ffd9b3 title=bold,left visual=frame

[Test frameworks
(external dependencies)] <--
[Adapters] -->
[Shared] -->
