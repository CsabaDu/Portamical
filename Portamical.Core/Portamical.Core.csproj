<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build Settings -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Package Info -->
    <Version>4.1.2</Version>
    <Title>Portamical.Core</Title>
    <Authors>CsabaDu</Authors>
    <Company>CsabaDu</Company>
    <Description>'Portamical.Core' is the framework-agnostic core of 'Portamical': a universal, identity-driven test data modeling framework for .NET.</Description>
    <Copyright>(c) 2026. Csaba Dudas (CsabaDu)</Copyright>

    <!-- Package Assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

    <!-- Repository -->
    <RepositoryUrl>https://github.com/CsabaDu/Portamical/tree/master/Portamical.Core</RepositoryUrl>
    <PackageTags>test; unittest; testdata; frameworkagnostic; portable; dynamicdata; datadriven; mstest; nunit; xunit; xunitv3; tunit;</PackageTags>

    <!-- Release Notes -->
    <PackageReleaseNotes>
    v4.1.2 (2026-06-30) - Dependency Update: Portamical.Core.Formatting v2.1.0 → v2.1.1

    This release updates the formatting library dependency to v2.1.1, bringing documentation completeness, string building optimizations, and code quality improvements - all with full backward compatibility.

    **Key Improvements** (via Portamical.Core.Formatting v2.1.1):
    • Complete XML documentation for all private members and methods
    • StringBuilder capacity pre-computation for ALL collection sizes (removed 32-item limit)
    • Fast-path iterative joining for small lists (1-3 items) using CreateSeparatedString
    • Tuple formatting optimized for up to 8 elements (maxCount: 8)
    • Local method pattern reduces closure allocations in tight loops
    • Enhanced null handling with explicit fallback strategies
    • Better error handling in Stream formatting (Debug.WriteLine)
    • Thread-safe concurrent caching for hot-path operations

    **Compatibility**: ✅ No breaking changes, drop-in replacement for v4.1.1

    For details: https://github.com/CsabaDu/Portamical/blob/master/Portamical.Core.Formatting/README.md
    </PackageReleaseNotes>

    <!-- Package Generation -->
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>

    <!-- Symbols -->
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Documentation -->
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Portamical.Core.Formatting" Version="2.1.1" />
  </ItemGroup>

  <!-- T4 tooling support -->

  <!-- Tell VS which .tt files to transform and where to put output -->
  <ItemGroup>
    <None Update="Factories\TestDataFactory.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestDataFactory.generated.cs</LastGenOutput>
    </None>
    <None Update="TestDataTypes\Models\General\TestData.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestData.generated.cs</LastGenOutput>
    </None>
    <None Update="TestDataTypes\Models\Specialized\TestDataReturns.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestDataReturns.generated.cs</LastGenOutput>
    </None>
    <None Update="TestDataTypes\Models\Specialized\TestDataThrows.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestDataThrows.generated.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- Include generated files in compilation -->
  <ItemGroup>
    <Compile Update="Factories\TestDataFactory.generated.cs">
      <DependentUpon>TestDataFactory.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="TestDataTypes\Models\General\TestData.generated.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TestData.tt</DependentUpon>
    </Compile>
    <Compile Update="TestDataTypes\Models\Specialized\TestDataReturns.generated.cs">
      <DependentUpon>TestDataReturns.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="TestDataTypes\Models\Specialized\TestDataThrows.generated.cs">
      <DependentUpon>TestDataThrows.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

</Project>
