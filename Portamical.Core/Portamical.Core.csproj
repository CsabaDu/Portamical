<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build Settings -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Package Info -->
    <Version>3.2.2</Version>
    <Title>Portamical.Core</Title>
    <Authors>CsabaDu</Authors>
    <Company>CsabaDu</Company>
    <Description>'Portamical.Core' is the framework-agnostic core of 'Portamical': a universal, identity-driven test data modeling framework for .NET.</Description>
    <Copyright>(c) 2026. Csaba Dudas (CsabaDu)</Copyright>

    <!-- Package Assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

    <!-- Repository -->
    <RepositoryUrl>https://github.com/CsabaDu/Portamical/tree/master/Portamical.Core</RepositoryUrl>
    <PackageTags>test; unittest; testdata; frameworkagnostic; portable; dynamicdata; datadriven; mstest; nunit; xunit; xunitv3; tunit;</PackageTags>

    <!-- Release Notes -->
    <PackageReleaseNotes>
      v3.2.2 (2026-06-08) - JoinWithComma Empty Collection Bugfix

      Bug Fixes
      - ValueFormatter.JoinWithComma: Fixed incorrect return value for empty collections
      - Empty collections now correctly return empty string (`""`) instead of `"null"`
      - Distinguishes between empty collection and collection with single null item
      - Aligns behavior with `string.Join(", ", items)` semantics

      No Breaking Changes
      This is a patch release that fixes a bug in internal formatting behavior. Existing code continues to work as expected, with improved correctness for edge cases.

      Impact
      - Tuple formatting: `Format(ValueTuple.Create())` now produces `"()"` instead of `"(null)"`
      - Empty array formatting: `Format(Array.Empty&lt;int&gt;())` now produces `"[0]: []"` instead of `"[0]: [null]"`
      - Generic type formatting with no type parameters (edge case) improved
    </PackageReleaseNotes>

    <!-- Package Generation -->
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>

    <!-- Symbols -->
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- T4 tooling support -->

  <!-- Tell VS which .tt files to transform and where to put output -->
  <ItemGroup>
    <None Update="Factories\TestDataFactory.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestDataFactory.generated.cs</LastGenOutput>
    </None>
    <None Update="TestDataTypes\Models\General\TestData.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestData.generated.cs</LastGenOutput>
    </None>
    <None Update="TestDataTypes\Models\Specialized\TestDataReturns.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestDataReturns.generated.cs</LastGenOutput>
    </None>
    <None Update="TestDataTypes\Models\Specialized\TestDataThrows.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestDataThrows.generated.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- Include generated files in compilation -->
  <ItemGroup>
    <Compile Update="Factories\TestDataFactory.generated.cs">
      <DependentUpon>TestDataFactory.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="TestDataTypes\Models\General\TestData.generated.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TestData.tt</DependentUpon>
    </Compile>
    <Compile Update="TestDataTypes\Models\Specialized\TestDataReturns.generated.cs">
      <DependentUpon>TestDataReturns.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="TestDataTypes\Models\Specialized\TestDataThrows.generated.cs">
      <DependentUpon>TestDataThrows.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

</Project>