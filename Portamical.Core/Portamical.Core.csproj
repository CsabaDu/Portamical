<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build Settings -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Package Info -->
    <Version>4.0.0</Version>
    <Title>Portamical.Core</Title>
    <Authors>CsabaDu</Authors>
    <Company>CsabaDu</Company>
    <Description>'Portamical.Core' is the framework-agnostic core of 'Portamical': a universal, identity-driven test data modeling framework for .NET.</Description>
    <Copyright>(c) 2026. Csaba Dudas (CsabaDu)</Copyright>

    <!-- Package Assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

    <!-- Repository -->
    <RepositoryUrl>https://github.com/CsabaDu/Portamical/tree/master/Portamical.Core</RepositoryUrl>
    <PackageTags>test; unittest; testdata; frameworkagnostic; portable; dynamicdata; datadriven; mstest; nunit; xunit; xunitv3; tunit;</PackageTags>

    <!-- Release Notes -->
    <PackageReleaseNotes>
      v4.0.0 (2026-06-26) - Major Architectural Evolution: Standalone Formatting Library &amp; API Refinement

      BREAKING CHANGES:
      1. Formatting Library Extracted
         - NEW: Portamical.Core.Formatting standalone package (auto-included as dependency)
         - IMPACT: Formatting utilities now in separate NuGet package
         - MIGRATION: Update to Portamical.Core v4.0.0 (includes Portamical.Core.Formatting automatically)

      2. Formatter API Refinement
         - RENAMED: ValueFormatter → DefaultFormatter (better clarity)
         - MOVED: IFormatter to Portamical.Core.Formatting.CustomFormatters namespace
         - CHANGED: IFormatter&lt;T&gt;.Format(T) return type: string? → string (non-nullable)
         - NEW: Formatter&lt;T&gt; abstract base class for easier custom formatter implementation
         - MIGRATION: Change 'using static Portamical.Core.Formatting.ValueFormatter;' to 'using static Portamical.Core.Formatting.Builder;'

      3. Formatter Registry API Changes
         - REMOVED: ValueFormatter.Registry, RegisterFormatter, UnregisterFormatter
         - NEW: Formatter static class with simplified registration API
         - MIGRATION: Use Formatter.RegisterFormatter&lt;T&gt;() instead of ValueFormatter.Registry

      NEW FEATURES:
      - Standalone Formatting Library (Portamical.Core.Formatting v1.0.0)
        - Independently versioned formatting infrastructure
        - Builder utilities: FallbackIfNull, JoinWithComma, CreateSeparatedString, CopyAsSpan
        - Singleton pattern: DefaultFormatter.Instance
      - Formatter&lt;T&gt; abstract base class simplifies custom formatter implementation
      - ASCII character caching (5x performance improvement for printable chars 32-126)
      - Comprehensive XML documentation with thread-safety guarantees

      IMPROVEMENTS:
      - Simplified custom formatter API surface
      - Zero-allocation span-based string building
      - Enhanced performance in character formatting hot paths
      - Complete migration guide included in README

      MIGRATION GUIDE:
      Step 1: Update package - dotnet add package Portamical.Core --version 4.0.0
      Step 2: Update namespaces - 'using static Portamical.Core.Formatting.Builder;'
      Step 3: Update formatter calls - DefaultFormatter.Format() instead of ValueFormatter.Format()
      Step 4: Update custom formatters - inherit from Formatter&lt;T&gt; base class

      For full details see: https://github.com/CsabaDu/Portamical/blob/master/Portamical.Core/README.md
    </PackageReleaseNotes>

    <!-- Package Generation -->
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>

    <!-- Symbols -->
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Documentation -->
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Portamical.Core.Formatting" Version="1.0.0" />
  </ItemGroup>

  <!-- T4 tooling support -->

  <!-- Tell VS which .tt files to transform and where to put output -->
  <ItemGroup>
    <None Update="Factories\TestDataFactory.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestDataFactory.generated.cs</LastGenOutput>
    </None>
    <None Update="TestDataTypes\Models\General\TestData.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestData.generated.cs</LastGenOutput>
    </None>
    <None Update="TestDataTypes\Models\Specialized\TestDataReturns.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestDataReturns.generated.cs</LastGenOutput>
    </None>
    <None Update="TestDataTypes\Models\Specialized\TestDataThrows.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestDataThrows.generated.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- Include generated files in compilation -->
  <ItemGroup>
    <Compile Update="Factories\TestDataFactory.generated.cs">
      <DependentUpon>TestDataFactory.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="TestDataTypes\Models\General\TestData.generated.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TestData.tt</DependentUpon>
    </Compile>
    <Compile Update="TestDataTypes\Models\Specialized\TestDataReturns.generated.cs">
      <DependentUpon>TestDataReturns.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="TestDataTypes\Models\Specialized\TestDataThrows.generated.cs">
      <DependentUpon>TestDataThrows.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

</Project>
