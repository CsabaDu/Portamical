<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build Settings -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Package Info -->
    <Version>3.3.0</Version>
    <Title>Portamical.Core</Title>
    <Authors>CsabaDu</Authors>
    <Company>CsabaDu</Company>
    <Description>'Portamical.Core' is the framework-agnostic core of 'Portamical': a universal, identity-driven test data modeling framework for .NET.</Description>
    <Copyright>(c) 2026. Csaba Dudas (CsabaDu)</Copyright>

    <!-- Package Assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

    <!-- Repository -->
    <RepositoryUrl>https://github.com/CsabaDu/Portamical/tree/master/Portamical.Core</RepositoryUrl>
    <PackageTags>test; unittest; testdata; frameworkagnostic; portable; dynamicdata; datadriven; mstest; nunit; xunit; xunitv3; tunit;</PackageTags>

    <!-- Release Notes -->
    <PackageReleaseNotes>
      v3.3.0 (2026-06-13) - Extensibility, Performance &amp; Documentation Release

      BREAKING CHANGES:
      - DefaultFormatter refactored to use Formatter base class
      - Helper methods (FallbackIfNull, JoinWithComma) moved to Formatter base class

      Added:
      - IFormatter interface for custom formatter implementations
        • IFormatter (non-generic) for object formatting
        • IFormatter&lt;T&gt; (generic) for type-safe formatting
      - Formatter abstract base class with shared formatting utilities
        • Constants: NullString, MaxCount, Separator
        • Helpers: FallbackIfNull, JoinWithComma, CreateSeparatedString, CopyAsSpan
      - Custom formatter registry in DefaultFormatter
        • Static Registry property for registering custom formatters by Type
        • Format() checks registry before built-in pattern matching
        • Enables extensibility without modifying DefaultFormatter source
      - Delegate formatting support in DefaultFormatter.Format() method
        • Formats Func&lt;T&gt;, Action&lt;T&gt;, Predicate&lt;T&gt;, and custom delegate types
        • Distinguishes between named methods (e.g., "WriteLine") and anonymous lambdas
        • Output format: "DelegateType (methodName)" or "DelegateType (anonymous)"

      Performance Optimizations:
      - Zero-allocation string building using string.Create() with Span&lt;char&gt;
        • JoinWithComma: 66-75% fewer allocations for 2-3 item collections
        • Format(string): Direct span write for quoted strings
        • Format(object?, object?): Zero-copy key-value pair formatting
        • Format(Delegate): Allocation-free delegate name construction
        • Format(Type): Span-based array/nullable/generic formatting
      - Reduced GC pressure in hot paths (tuples, type arguments, small collections)
      - CreateSeparatedString: Shared by DefaultFormatter and TestDataBase for zero-copy concatenation

      Improved:
      - Optimized pattern matching in DefaultFormatter (removed redundant string check)
      - Extracted GetKvpPropValues helper for KeyValuePair property access
      - Simplified TestDataBase.CreateTestCaseName() using CreateSeparatedString helper

      Documentation:
      - Added comprehensive XML documentation for IFormatter and Formatter
      - Added comprehensive XML documentation for DefaultFormatter
        • Detailed type-specific formatting table for 12+ types
        • Formatter registration API fully documented
        • Performance characteristics and thread-safety notes
        • Extensive examples for all formatting scenarios
      - Enhanced TestDataExpected XML documentation
        • Comprehensive Format() method documentation with type table
        • GetResult() documentation with fallback strategy details
        • Null handling strategy and integration with Resolver documented
      - Updated TestDataReturns and TestDataThrows XML comments
        • Clarified base class formatting (not ToString)
        • Fixed incorrect type references
        • Improved examples with actual formatted output
        • Enhanced GetResultPrefix() and ToArgs() documentation
      - Added delegate formatting examples to Format() method documentation
      - Created PERFORMANCE_STRING_CREATE_OPTIMIZATION.md with detailed benchmarks
      - Updated all method docs to reflect "expectedType" terminology

      T4 Template Fixes:
      - All T4 templates now include #nullable enable directives
        • TestDataExpected.tt, TestDataReturns.tt, TestDataThrows.tt
        • Ensures CS8669 compiler warnings are suppressed
        • Regenerated all .generated.cs files with proper nullable context

      Testing:
      - Added 433 lines of tests for Formatter base class
      - Added 217 lines of tests for custom formatter registry
      - Added test parallelization control and cleanup for registry tests

      Migration Guide:
      - Change: using static Portamical.Core.Formatting.DefaultFormatter; 
        To: using static Portamical.Core.Formatting.Model.Formatter;
        (for FallbackIfNull, JoinWithComma access)
      - Custom formatters: Implement IFormatter&lt;T&gt; and register in DefaultFormatter.Registry
    </PackageReleaseNotes>

    <!-- Package Generation -->
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>

    <!-- Symbols -->
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Documentation -->
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Portamical.Core.Formatting" Version="1.0.0-pre" />
  </ItemGroup>

  <!-- T4 tooling support -->

  <!-- Tell VS which .tt files to transform and where to put output -->
  <ItemGroup>
    <None Update="Factories\TestDataFactory.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestDataFactory.generated.cs</LastGenOutput>
    </None>
    <None Update="TestDataTypes\Models\General\TestData.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestData.generated.cs</LastGenOutput>
    </None>
    <None Update="TestDataTypes\Models\Specialized\TestDataReturns.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestDataReturns.generated.cs</LastGenOutput>
    </None>
    <None Update="TestDataTypes\Models\Specialized\TestDataThrows.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>TestDataThrows.generated.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- Include generated files in compilation -->
  <ItemGroup>
    <Compile Update="Factories\TestDataFactory.generated.cs">
      <DependentUpon>TestDataFactory.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="TestDataTypes\Models\General\TestData.generated.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TestData.tt</DependentUpon>
    </Compile>
    <Compile Update="TestDataTypes\Models\Specialized\TestDataReturns.generated.cs">
      <DependentUpon>TestDataReturns.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="TestDataTypes\Models\Specialized\TestDataThrows.generated.cs">
      <DependentUpon>TestDataThrows.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

</Project>
