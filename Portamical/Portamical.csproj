<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build Settings -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Package Info -->
    <Version>2.3.0</Version>
    <Title>Portamical</Title>
    <Authors>CsabaDu</Authors>
    <Company>CsabaDu</Company>
    <Description>Shared utilities and base classes for cross‑framework test data solutions in .NET, built on the Portamical.Core data model.</Description>
    <Copyright>(c) 2026. Csaba Dudas (CsabaDu)</Copyright>

    <!-- Package Assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

    <!-- Repository -->
    <RepositoryUrl>https://github.com/CsabaDu/Portamical/tree/master/Portamical</RepositoryUrl>
    <PackageTags>test; unittest; testdata; frameworkagnostic; portable; dynamicdata; datadriven; async; mstest; nunit; xunit; xunitv3; tunit;</PackageTags>

    <!-- Release Notes -->
<PackageReleaseNotes>v2.2.1 - 2026-04-23
Changed:
- Portamical.Core dependency 2.0.1 → 2.2.0</PackageReleaseNotes>
    <PackageReleaseNotes>
      v2.3.0 - 2026-04-25
      Added:
      - CatchExceptionAsync(Func&lt;Task&gt;) - async exception catcher with fatal exception filtering
      - DoesNotThrowAsync(Func&lt;Task&gt;, Func&lt;string, ValueTask&gt;) - async action overload
      Changed:
      - CatchException(Action) - refactored as sync wrapper (backward compatible)
      - DoesNotThrow(Action, Action&lt;string&gt;) - refactored as sync wrapper (backward compatible)
      - Async assertion methods visibility: protected → public (non-breaking)
      Improved:
      - Completed async-first architecture from v2.2.0
      - Eliminated #pragma warning disable CA2012
      - Added comprehensive documentation for IsNotFatal and all new/changed methods
      - Consistent fatal exception handling across all sync/async paths
      Dependencies:
      - Portamical.Core 2.2.0 (unchanged)
      Breaking Changes:
      - None - fully backward compatible with 2.2.x
    </PackageReleaseNotes>
    
    <!-- Package Generation -->
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>

    <!-- Symbols -->
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Portamical.Core" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
