<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build Settings -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Package Info -->
    <Version>3.0.1</Version>
    <Title>Portamical</Title>
    <Authors>CsabaDu</Authors>
    <Company>CsabaDu</Company>
    <Description>Shared utilities and base classes for cross‑framework test data solutions in .NET, built on the Portamical.Core data model.</Description>
    <Copyright>(c) 2026. Csaba Dudas (CsabaDu)</Copyright>

    <!-- Package Assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

    <!-- Repository -->
    <RepositoryUrl>https://github.com/CsabaDu/Portamical/tree/master/Portamical</RepositoryUrl>
    <PackageTags>test; unittest; testdata; frameworkagnostic; portable; dynamicdata; datadriven; async; mstest; nunit; xunit; xunitv3; tunit;</PackageTags>

    <!-- Release Notes -->
    <PackageReleaseNotes>v3.0.1 - 2026-05-01

Added
- Null parameter validation to async assertion methods (`DoesNotThrowAsync(Func&lt;Task&gt;`, `Func&lt;string, ValueTask&gt;)`, `ThrowsDetailsAsync&lt;TException&gt;(Func&lt;Task&gt;`, `TException, Func&lt;Func&lt;Task&gt;, ValueTask&lt;Exception?&gt;&gt;`, `Func&lt;Type, object, ValueTask&gt;`, `Func&lt;string, string?, ValueTask&gt;`, `Func&lt;string, ValueTask&gt;), CatchExceptionAsync(Func&lt;Task&gt;)`)
Fixed
- `DoesNotThrowAsync(Func&lt;Task&gt;, Func&lt;string, ValueTask&gt;)`: Null check now occurs before `CatchExceptionAsync(Func&lt;Task&gt;)` call
- `ThrowsDetailsAsync&lt;TException&gt;(Func&lt;Task&gt;, TException, Func&lt;Func&lt;Task&gt;, ValueTask&lt;Exception?&gt;&gt;, Func&lt;Type, object, ValueTask&gt;, Func&lt;string, string?, ValueTask&gt;, Func&lt;string, ValueTask&gt;)`: Added validation for all 5 delegate parameters
- `CatchExceptionAsync(Func&lt;Task&gt;)`: Added missing attempt parameter validation</PackageReleaseNotes>
    
    <!-- Package Generation -->
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>

    <!-- Symbols -->
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Portamical.Core" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
