<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build Settings -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Package Info -->
    <Version>4.0.0</Version>
    <Title>Portamical</Title>
    <Authors>CsabaDu</Authors>
    <Company>CsabaDu</Company>
    <Description>Shared utilities and base classes for cross‑framework test data solutions in .NET, built on the Portamical.Core data model.</Description>
    <Copyright>(c) 2026. Csaba Dudas (CsabaDu)</Copyright>

    <!-- Package Assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

    <!-- Repository -->
    <RepositoryUrl>https://github.com/CsabaDu/Portamical/tree/master/Portamical</RepositoryUrl>
    <PackageTags>test; unittest; testdata; frameworkagnostic; portable; dynamicdata; datadriven; async; mstest; nunit; xunit; xunitv3; tunit;</PackageTags>

    <!-- Release Notes -->
    <PackageReleaseNotes>
      v4.0.0 (2026-06-26):

      Updated
      - **Portamical.Core dependency updated to v4.0.0**
      - Maintains compatibility with latest Portamical.Core features and improvements

      Improved
      - **Complete test coverage for assertion infrastructure**
        - Fatal exception filtering (`IsNotFatal`) - 8 new tests covering all branches
        - Sync wrapper lambda execution - Fixed `ThrowsDetails` to properly invoke wrapped attempt
        - Equality assertions - Added BigInteger, custom type fallback, and non-interned string tests
        - NaN handling - Complete branch coverage for double/float special value comparisons
      - **Enhanced documentation**
        - Added comprehensive XML documentation for `ThreadSafeSync(Func&lt;Task&gt;)` overload
        - Includes usage examples, performance notes, and thread safety guidance

      Fixed
      - **`ThrowsDetails` sync wrapper** - Now properly uses wrapped lambda instead of calling original action twice
        - Lines 610-617: `catchExceptionAsync` now invokes `attemptAsync` parameter correctly
        - Test updated: `ThrowsDetails_catchExceptionInvoked_receivesWrappedAttempt`

      Test Coverage
      - **189 total tests** (up from 183)
      - 6 new tests for fatal exception branches
      - 5 new tests for equality edge cases (BigInteger, custom types, non-interned strings)
      - 1 new test for NaN special value handling
      - All tests passing with zero regressions</PackageReleaseNotes>
    
    <!-- Package Generation -->
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>

    <!-- Symbols -->
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Portamical.Core" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
